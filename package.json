{
  "name": "the-3d-lab",
  "private": true,
  "version": "0.1.0",
  "description": "THE 3D LAB — From Imagination to Reality. An interactive game for learning 3D modelling, CAD, engineering, physics and product invention.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
